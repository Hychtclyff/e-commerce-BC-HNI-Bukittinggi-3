# ==========================================================================
# .env.example — Template Konfigurasi TIJARAH-3
# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN isi credential asli di file ini — file ini di-commit ke git.
# ==========================================================================

# ── 1. APP CONFIG ──────────────────────────────────────────────────────────
# URL aplikasi (development: http://localhost:3000 | production: https://domain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 2. SUPABASE ────────────────────────────────────────────────────────────
# Dapatkan dari: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Hanya untuk server-side (API Routes, Server Actions) — JANGAN expose ke client
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── 3. DATABASE ────────────────────────────────────────────────────────────
# Dapatkan dari: Supabase Dashboard → Project Settings → Database
# Gunakan port 6543 (Transaction Pooler) untuk runtime Next.js
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Gunakan port 5432 (Direct) untuk migration CLI
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── 4. GOOGLE OAUTH ────────────────────────────────────────────────────────
# Dapatkan dari: Google Cloud Console → APIs & Services → Credentials
# Client ID biasanya aman di .env (tidak secret), tapi Secret harus di .env.local
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# ── 5. ANALYTICS ───────────────────────────────────────────────────────────
# Dapatkan dari: Google Analytics → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── 6. DEV AUTO-LOGIN (hanya untuk development) ────────────────────────────
# Buat akun ini sekali di Supabase → Authentication → Users → Add user
# Aktifkan "Disable email confirmations" di Auth → Providers → Email (untuk dev)
DEV_AUTO_EMAIL=dev@tijarah.local
DEV_AUTO_PASSWORD=ganti_dengan_password_dev_anda
