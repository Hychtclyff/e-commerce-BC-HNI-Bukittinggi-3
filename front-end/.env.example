# ==========================================================================
# .env.example — Template Konfigurasi TIJARAH-3
# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN isi credential asli di file ini — file ini di-commit ke git.
# ==========================================================================

# ── 1. APP CONFIG ──────────────────────────────────────────────────────────
# URL aplikasi (development: http://localhost:3000 | production: https://domain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BE_URL=http://localhost:5000/api/v1

# ── 2. ANALYTICS ───────────────────────────────────────────────────────────
# Dapatkan dari: Google Analytics → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── 4. DEV AUTO-LOGIN (hanya untuk development) ────────────────────────────
DEV_AUTO_EMAIL=dev@tijarah.local
DEV_AUTO_PASSWORD=ganti_dengan_password_dev_anda
