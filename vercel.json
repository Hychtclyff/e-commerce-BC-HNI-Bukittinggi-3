{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "back-end": {
      "root": "back-end",
      "framework": "fastify",
      "entrypoint": "src/vercel.ts"
    },
    "front-end": {
      "root": "front-end",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "back-end",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "back-end" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "front-end" }
    }
  ]
}
