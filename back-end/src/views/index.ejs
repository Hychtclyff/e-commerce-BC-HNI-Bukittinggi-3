<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <title>
    <%= title %>
  </title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      background-color: #f3f4f6;
      color: #111827;
    }

    .container {
      text-align: center;
      background: white;
      padding: 2rem 4rem;
      border-radius: 1rem;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    }

    h1 {
      color: #2563eb;
    }

    p {
      color: #4b5563;
    }
  </style>
</head>

<body>
  <div class="container">
    <h1>
      <%= heading %>
    </h1>
    <p>
      <%= message %>
    </p>
  </div>
</body>

</html>